/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://raw.githubusercontent.com https://nominatim.openstreetmap.org https://router.project-osrm.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/*.html
  Cache-Control: no-cache

/data11.csv
  Cache-Control: private, no-store

/data/*.csv
  Cache-Control: private, no-store

/data/prepared/*
  Cache-Control: private, no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/perf-runtime/*
  Cache-Control: public, max-age=3600

/*.js
  Cache-Control: public, max-age=3600
